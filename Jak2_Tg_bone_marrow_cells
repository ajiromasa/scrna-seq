def set_dpt_root_cluster_center_diffmap(adata, group_key, root_label):
    mask = adata.obs[group_key].astype(str).values == str(root_label) 
    Xdm = adata.obsm["X_diffmap"][mask] 
    center = Xdm.mean(axis=0)
    d2 = np.sum((Xdm - center) ** 2, axis=1)
    idx_local = np.argmin(d2) 
    root_obs_name = adata.obs_names[mask][idx_local]
    adata.uns["iroot"] = int(adata.obs_names.get_loc(root_obs_name))
    return root_obs_name


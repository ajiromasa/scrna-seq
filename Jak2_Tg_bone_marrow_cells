hue_order  = ["WT1","WT2","WT3","MT1","MT2","MT3"]
path_order = ["HSC_to_MkP","HSC_to_HSC-MkP"]
plot_df["path"]      = pd.Categorical(plot_df["path"], categories=path_order, ordered=True)
plot_df["condition"] = pd.Categorical(plot_df["condition"], categories=hue_order, ordered=True)
plot_df = plot_df.sort_values(["path","condition"])
palette = {"WT1":"lightgreen","WT2":"yellowgreen","WT3":"green", "MT1":"magenta","MT2":"red","MT3":"purple"}
plt.figure(figsize=(5,4))
ax = sns.barplot(
    data=plot_df, x="path", y="delta_median",
    hue="condition", order=path_order, hue_order=hue_order,
    errorbar=None, palette=palette, edgecolor="black"
)
for container, cond in zip(ax.containers, hue_order):
    sub = plot_df[plot_df["condition"] == cond]
    # container.patches と sub の行を 1:1 で対応
    for bar, (_, r) in zip(container.patches, sub.iterrows()):
        y = bar.get_height()    
        x = bar.get_x() + bar.get_width()/2.0  
        yerr_low  = max(0.0, y - r["ci_lo"])
        yerr_high = max(0.0, r["ci_hi"] - y)
        plt.errorbar(x, y, yerr=np.array([[yerr_low],[yerr_high]]), fmt="none", ecolor="black", elinewidth=1.2, capsize=3, capthick=1.2)
ax.set_xlabel("")
ax.set_ylabel("pseudotime median Δ (HSC → endpoint)")
ax.set_title("DPT_pseudotime")
ax.legend(title="condition", bbox_to_anchor=(1.05,1), loc="upper left", frameon=False)
plt.tight_layout()
plt.show()

def _ratio_bad(M):
    if sparse.issparse(M):
        data = M.data 
    else:
        data = np.asarray(M)
    return float(np.mean(~np.isfinite(data)))

def _ratio_zerovar(M):
    A = M.toarray() if sparse.issparse(M) else np.asarray(M)
    return float(np.mean(np.nanstd(A, axis=0) == 0))


def get_pt(adata, group_key, cluster, pt_key):
    s = adata.obs.copy()
    if pt_key not in s.columns:raise KeyError(f"{pt_key} not in adata.obs")
    if group_key not in s.columns:raise KeyError(f"{group_key} not in adata.obs")

    s = s.replace([np.inf, -np.inf], np.nan).dropna(subset=[pt_key])
    s = s[s[group_key].astype(str) == str(cluster)]
    return s[pt_key].to_numpy()

def bootstrap_ci_delta_median(a, b, B=2000, seed=0):
    rng = np.random.default_rng(seed)
    est = []
    for _ in range(B):
        aa = rng.choice(a, size=len(a), replace=True)
        bb = rng.choice(b, size=len(b), replace=True)
        est.append(np.median(bb) - np.median(aa))
    lo, hi = np.percentile(est, [2.5, 97.5])
    return float(np.median(b) - np.median(a)), float(lo), float(hi)


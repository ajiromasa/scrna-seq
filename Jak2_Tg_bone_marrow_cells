def _clean_inplace(M):
    if sparse.issparse(M):
        M = M.tocsr(copy=True)
        if M.dtype != np.float64:
            M.data = M.data.astype(np.float64, copy=False)
        bad = ~np.isfinite(M.data)
        if bad.any():
            M.data[bad] = 0.0
        M.data[M.data < 0] = 0.0
        return M
    else:
        A = np.asarray(M, dtype=np.float64, order="C")
        A[~np.isfinite(A)] = 0.0
        A[A < 0] = 0.0
        return A

